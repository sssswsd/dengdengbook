# 复制成 .env 才会生效（.env 不进版本库；这个文件会进，所以不要填真 key）
#
# 路径写法：
#   sqlite:///./dengdeng.db            相对路径（相对启动时的当前目录）
#   sqlite:///C:/path/to/dengdeng.db  Windows 绝对路径
#   sqlite:////abs/path/dengdeng.db   Linux/macOS 绝对路径（四个斜杠）
#
# 留空或不建 .env 时，代码会用它自己的默认值：
#   sqlite:///<backend 目录>/dengdeng.db
DATABASE_URL=sqlite:///./dengdeng.db

# 想换成 Postgres 时（docker compose up 之后）
# DATABASE_URL=postgresql+psycopg://dengdeng:dengdeng@localhost:5432/dengdeng


# ---------- 大模型（自由对话）----------
# 不填 key 时自动关闭，/ask 回落到人工答案库，系统照常可读。
#
# 通义千问（DashScope）：https://dashscope.console.aliyun.com
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL=qwen-plus
# DeepSeek：https://platform.deepseek.com
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# 总开关（1 开 / 0 关）。答辩想稳就设 0，走预置答案。
LLM_ENABLED=1

# 首字超时（秒）。超过就直接回落，不让孩子干等。
LLM_FIRST_TOKEN_TIMEOUT=4

# 单次会话最多问几次，防成本失控。
LLM_MAX_ASKS=30
