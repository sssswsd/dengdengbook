{
  "chapter": {
    "id": "ch04",
    "title": "谁告诉它的",
    "subtitle": "等等，为什么？ · 第 2 章",
    "topic": "labeling",
    "order_no": 2
  },
  "summary": "机器现在认识猫、狗、汽车，阿芽以为它什么都知道。她拿爷爷在山里拍的穿山甲照片考它，它说「刺猬」；又拿貘的照片，它说「猪」。她不服气，去翻它学过的东西，发现每张照片背后都有一个手写的小标签，笔迹各不相同，有几张只画了一个问号。它认识的每一样东西，都是有人一张一张告诉它的。",
  "term": "标注",
  "goals": {
    "G1": "它认识的东西，是人一张张标出来的",
    "G2": "标的人也会错，错会留在里面",
    "G3": "你标什么，它就认什么"
  },
  "misconceptions": {
    "M1": "它什么都知道",
    "M2": "它自己会看，不用人教"
  },
  "segments": [
    {
      "id": "seg4_p01",
      "seq": 1,
      "kind": "opening",
      "is_hook": 0,
      "title": "它现在认识很多东西",
      "image": "ch04_p1.png",
      "body": {
        "kicker": "第二章",
        "lines": [
          "它现在认识很多东西。",
          "猫、狗、汽车、苹果。"
        ],
        "note": "我试了很多回，一次都没错。",
        "bubbles": [
          {
            "q": "它怎么什么都知道？",
            "a": "我也这么想过。"
          },
          {
            "q": "是它自己学会的吗？",
            "a": "往下翻。"
          }
        ]
      }
    },
    {
      "id": "seg4_p02",
      "seq": 2,
      "kind": "story",
      "is_hook": 0,
      "variant": "plain",
      "title": "我想考考它",
      "body": {
        "lines": [
          "我想考考它。",
          "我带了一张照片来。"
        ],
        "note": "爷爷在山里拍的。\n他拍了三张，只有这一张清楚。"
      }
    },
    {
      "id": "seg4_p03",
      "seq": 3,
      "kind": "story",
      "is_hook": 0,
      "title": "它说：刺猬",
      "image": "ch04_p3.png",
      "body": {
        "lines": [
          "它看了很久。",
          "它说：刺猬。"
        ],
        "note": "照片上那不是刺猬。\n它有鳞片，会挖洞，舌头很长。\n它叫穿山甲。",
        "bubbles": [
          {
            "q": "它看错了吗？",
            "a": "看错了。可它看得很认真，看了很久。"
          },
          {
            "q": "它为什么会认错？",
            "a": "翻两页，你就知道了。"
          }
        ]
      }
    },
    {
      "id": "seg4_p04",
      "seq": 4,
      "kind": "story",
      "is_hook": 0,
      "variant": "plain",
      "title": "它说：猪",
      "body": {
        "lines": [
          "我又拿了一张。",
          "它说：猪。"
        ],
        "note": "那是貘（mò）。\n鼻子长长的，像一小截象。",
        "bubbles": [
          {
            "q": "它是在乱猜吗？",
            "a": "它没有乱猜。\n它在挑一个最像的。\n挑得很快，一点都没犹豫。"
          },
          {
            "q": "那它知道自己在猜吗？",
            "a": "不知道。"
          }
        ]
      }
    },
    {
      "id": "seg4_p05",
      "seq": 5,
      "kind": "story",
      "is_hook": 0,
      "variant": "plain",
      "title": "我去翻它学过的东西",
      "body": {
        "lines": [
          "我不服气。",
          "我去翻它学过的东西。"
        ],
        "note": "它有一个大盒子，里面全是照片。"
      }
    },
    {
      "id": "seg4_p06",
      "seq": 6,
      "kind": "story",
      "is_hook": 0,
      "is_checkpoint": 1,
      "goal_tag": "G1",
      "title": "每一张背后都有字",
      "image": "ch04_p6.png",
      "body": {
        "lines": [
          "我把它们翻过来。",
          "每一张背后，都有字。"
        ],
        "note": "笔迹都不一样。\n有小孩写的，有大人写的，\n有写错了划掉重写的。\n\n还有几张，只有一个问号。",
        "hold_ms": 2000,
        "bubbles": [
          {
            "q": "这些字是谁写的？",
            "a": "很多人。一张一张写的。"
          },
          {
            "q": "为什么笔迹都不一样？",
            "a": "因为不是同一个人。\n每个人认识的东西，都不一样。"
          },
          {
            "q": "那个问号是什么意思？",
            "a": "是写的人也不认识。\n就画了一个问号。"
          }
        ]
      }
    },
    {
      "id": "seg4_p07",
      "seq": 7,
      "kind": "story",
      "is_hook": 0,
      "variant": "plain",
      "title": "老师说",
      "body": {
        "lines": [
          "老师说，这些照片，",
          "是很多人一张一张标出来的。"
        ],
        "note": "标的人也有不认识穿山甲的。\n所以它也就没有学会。",
        "bubbles": [
          {
            "q": "那它到底认识多少个东西？",
            "a": "有多少张照片背后写了字，\n它就认识多少个。"
          },
          {
            "q": "它会不会自己再学？",
            "a": "不会。\n得有人再给它看新的照片。"
          }
        ]
      }
    },
    {
      "id": "seg4_p08",
      "seq": 8,
      "kind": "level",
      "is_hook": 0,
      "variant": "level",
      "title": "你来标",
      "body": {
        "kicker": "轮到你了",
        "note": "你标了什么，它就认识什么。",
        "level": {
          "kind": "label",
          "prompt": "这六张照片，你来告诉它这是什么。",
          "labels": [
            "猫",
            "狗",
            "汽车",
            "斑马",
            "鳄鱼",
            "刺猬",
            "猪",
            "不知道"
          ],
          "items": [
            {
              "id": "ph1",
              "shape": "cat"
            },
            {
              "id": "ph2",
              "shape": "dog"
            },
            {
              "id": "ph3",
              "shape": "car"
            },
            {
              "id": "ph4",
              "shape": "zebra"
            },
            {
              "id": "ph5",
              "shape": "pangolin"
            },
            {
              "id": "ph6",
              "shape": "tapir"
            }
          ],
          "targets": [
            {
              "id": "tg1",
              "name": "穿山甲",
              "from": "ph5",
              "fallback": "刺猬",
              "shape": "pangolin"
            },
            {
              "id": "tg2",
              "name": "貘",
              "from": "ph6",
              "fallback": "猪",
              "shape": "tapir"
            }
          ],
          "test_prompt": "现在给它看这个："
        }
      }
    },
    {
      "id": "seg4_p09",
      "seq": 9,
      "kind": "story",
      "is_hook": 0,
      "variant": "plain",
      "title": "它认的不是照片",
      "body": {
        "lines": [
          "我标完，它就认得了。",
          "我标错的地方，它也认得了。"
        ],
        "note": "它认的不是那张照片。\n是我写在背后的话。",
        "bubbles": [
          {
            "q": "那我标错了怎么办？",
            "a": "它就跟着错。\n而且它不会知道。"
          }
        ]
      }
    },
    {
      "id": "seg4_p10",
      "seq": 10,
      "kind": "closing",
      "is_hook": 0,
      "title": "那标错的呢",
      "image": "ch04_p10.png",
      "body": {
        "lines": [
          "我问老师：",
          "标错的那些，怎么办？"
        ],
        "note": "老师说：它们还在里面。\n\n没有人会回来擦。\n\n所以下次再教它的时候，\n要教得准一点。",
        "bubbles": [
          {
            "q": "为什么不擦掉？",
            "a": "因为太多了。\n也因为，没有人知道哪些是错的。"
          },
          {
            "q": "那它以后会一直错下去吗？",
            "a": "得多给它看几张对的。\n看得多了，它才会改。"
          }
        ]
      }
    },
    {
      "id": "seg4_p11",
      "seq": 11,
      "kind": "glossary",
      "is_hook": 0,
      "variant": "naming",
      "title": "它有个名字",
      "body": {
        "kicker": "它有个名字",
        "lines": [
          "你刚才看见的那些字，",
          "有一个名字。"
        ],
        "term": "标注",
        "term_pinyin": "biāo zhù",
        "definition": "人一张一张给照片写上名字。\n它认识的东西，都是从这些名字里来的。",
        "footnote": "写名字的人也会错。\n错的那一张，也一起教给它了。",
        "takeaway": "它知道的，是别人告诉它的。"
      }
    },
    {
      "id": "seg4_x_example",
      "seq": null,
      "kind": "hook",
      "is_hook": 1,
      "goal_tag": "G1",
      "title": "你就是那个标的人",
      "body": {
        "lines": [
          "你教过弟弟认狗吗？",
          "你指着一只狗说：狗。"
        ],
        "note": "那天你就是标的人。\n\n他后来见到每一只狗，都叫狗。\n他信的是你的话。"
      }
    },
    {
      "id": "seg4_x_again",
      "seq": null,
      "kind": "hook",
      "is_hook": 1,
      "goal_tag": "G2",
      "title": "要是标的人都错了呢",
      "body": {
        "lines": [
          "如果一百个人标同一张照片，",
          "一百个人都标错了。"
        ],
        "note": "它也会跟着错。\n而且错得很有把握。\n\n因为它从来没见过对的那个。"
      }
    },
    {
      "id": "seg4_x_back",
      "seq": null,
      "kind": "hook",
      "is_hook": 1,
      "goal_tag": "G1",
      "title": "回头看看那几张",
      "body": {
        "lines": [
          "翻回去，再看看那些照片背面。"
        ],
        "note": "有几张写着问号。\n\n那不是偷懒。\n是那个人也不知道。"
      }
    }
  ]
}
